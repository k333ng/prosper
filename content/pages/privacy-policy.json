                  "content": [
                    {
                      "type": "text",
                      "text": "3. Private Content and Encryption",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We take your privacy seriously. When you create content marked as \"private\" in the app, it is encrypted in a way that prevents even our internal team from viewing it under normal circumstances."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This private content can only be decrypted using a process that requires cooperation between two authorized team members — one who holds the encryption keys, and another who understands the decryption protocol. Neither person can access the content independently."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "We have no operational reason to access your private content and will only do so in response to a valid legal request, such as a court order. We do not use private content for analytics, training, moderation, or any other internal function."
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "preset": "starter/stack-12@1"
    },
