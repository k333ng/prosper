          "fields": {
            "text1": "FOR TEACHERS, GUIDES & COMMUNITY LEADERS",
            "text2": "Bring your people into practice",
            "text3": "Whether you lead a small circle or a movement, Prosper lets you create content for your community. Craft Praylists around your teaching. Design practices aligned with your mission. Give your people a space to practice together — not just learn, but live what you're pointing toward.",
            "text7": "Extend your impact",
            "text8": "Gather your tribe",
            "text9": "Earn from your wisdom",
            "text10": "Your teachings become daily practice, not just occasional workshops.",
            "text11": "Your community practices together, strengthening the field you're building.",
            "text12": "Premium content, subscriptions, or free offerings — your choice.",
            "label13": "APPLY TO LEAD"
          }
        }
